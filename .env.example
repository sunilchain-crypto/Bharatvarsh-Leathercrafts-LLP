# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYMENT GATEWAY CONFIGURATION (BHARATVARSH LEATHERCRAFTS LLP)
# Set your public API keys here. The checkout automatically falls back to Test Mode when empty.
# For Indian payments (UPI, RuPay, NetBanking, Cards):
VITE_RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id_here"

# For Global cards & international transactions:
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"

# Store Currency: Default INR (₹)
VITE_STORE_CURRENCY="INR"
