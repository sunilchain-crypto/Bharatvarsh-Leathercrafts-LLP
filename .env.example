# ==============================================================================
# BHARATVARSH LEATHERCRAFTS LLP - ENVIRONMENT CONFIGURATION TEMPLATE
# Hostinger Shared Hosting (hPanel) & Local Production Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Primary Domain URL (temporary preview URL or your permanent production domain)
# Examples:
#   Temporary: https://srv123.hostinger.com/your-app
#   Permanent: https://bharatvarshcrafts.com
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MYSQL)
# ------------------------------------------------------------------------------
# In Hostinger hPanel -> Databases -> MySQL Databases:
# Create your database and user, then fill in the values below.
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="Name"
DB_USER="our_username_here"
DB_PASSWORD="our_password_here"

# ------------------------------------------------------------------------------
# 3. MAIL CONFIGURATION (IMAP & SMTP - support@bharatvarshcrafts.com)
# ------------------------------------------------------------------------------
# In Hostinger hPanel -> Emails -> Email Accounts:
#
# A) INCOMING MAIL: IMAP (Fetches customer inquiries & support emails)
IMAP_HOST="imap.hostinger.com"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER="support@bharatvarshcrafts.com"
IMAP_PASS="your_hostinger_email_password_here"
#
# B) OUTGOING MAIL: SMTP (Sends GST receipts, order confirmations, quote alerts)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="support@bharatvarshcrafts.com"
SMTP_PASS="your_hostinger_email_password_here"
SMTP_FROM="Bharatvarsh Leathercrafts LLP <support@bharatvarshcrafts.com>"
NOTIFICATION_EMAIL="support@bharatvarshcrafts.com"

# ------------------------------------------------------------------------------
# 4. FILE & MEDIA STORAGE (HOST LOCAL DISK)
# ------------------------------------------------------------------------------
# Files are stored directly on the host's local disk inside ./uploads
UPLOAD_DIR="./uploads"

# ------------------------------------------------------------------------------
# 5. GEMINI AI API (SERVER-SIDE LUXURY CATALOG STORY & CONCIERGE)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAYS (OPTIONAL / TEST MODE IF EMPTY)
# ------------------------------------------------------------------------------
# Domestic Indian Payments (UPI, RuPay, NetBanking, Cards):
VITE_RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id_here"

# International Cards & Foreign Currency Checkout:
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"

# Store Currency (Default: INR ₹)
VITE_STORE_CURRENCY="INR"
